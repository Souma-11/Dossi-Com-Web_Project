# Port du serveur backend
PORT=5000

# URI de connexion MongoDB (base locale ou MongoDB Atlas en production)
MONGO_URI=mongodb://localhost:27017/dossicom

# Clé secrète JWT (À REMPLACER en production par une longue chaîne aléatoire)
JWT_SECRET=dossicom_super_secret_jwt_key_phase3_2026

# Durée de validité du token JWT
JWT_EXPIRES_IN=8h

# URL du frontend React (autorisation CORS + Socket.io)
CLIENT_URL=http://localhost:5173
